      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host_id", "asset_type", "adapter_id", "status", "source_refs", "configured_source_count", "observed_source_count", "item_count"],
        "properties": {
          "host_id": {"enum": ["codex", "claude", "hermes", "workbuddy", "antigravity"]},
          "asset_type": {"enum": ["skill", "plugin", "mcp", "cli", "sdk"]},
          "adapter_id": {"type": ["string", "null"]},
          "status": {"enum": ["observed", "partial", "missing", "not_connected", "placeholder", "error"]},
          "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "configured_source_count": {"type": "integer", "minimum": 0},
          "observed_source_count": {"type": "integer", "minimum": 0},
          "item_count": {"type": "integer", "minimum": 0}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["not_connected", "placeholder"]}}, "required": ["status"]},
            "then": {
              "properties": {
                "adapter_id": {"type": "null"},
                "source_refs": {"maxItems": 0},
                "configured_source_count": {"const": 0},
                "observed_source_count": {"const": 0},
                "item_count": {"const": 0}
              }
            },
            "else": {
              "properties": {
                "adapter_id": {"type": "string", "minLength": 1},
                "source_refs": {"minItems": 1},
                "configured_source_count": {"minimum": 1}
              }
            }
          },
          {
            "if": {"properties": {"status": {"const": "missing"}}, "required": ["status"]},
            "then": {
              "properties": {
                "observed_source_count": {"const": 0},
                "item_count": {"const": 0}
              }
            }
          },
          {
            "if": {
              "allOf": [
                {"properties": {"status": {"const": "observed"}}, "required": ["status"]},
                {
                  "anyOf": [
                    {"properties": {"host_id": {"enum": ["codex", "claude", "hermes", "workbuddy"]}, "asset_type": {"const": "skill"}}, "required": ["host_id", "asset_type"]},
                    {"properties": {"host_id": {"enum": ["codex", "claude"]}, "asset_type": {"const": "plugin"}}, "required": ["host_id", "asset_type"]},
                    {"properties": {"host_id": {"const": "codex"}, "asset_type": {"const": "cli"}}, "required": ["host_id", "asset_type"]}
                  ]
                }
              ]
            },
            "then": {"properties": {"observed_source_count": {"minimum": 1}}}
          },
          {
            "if": {"properties": {"host_id": {"const": "antigravity"}}, "required": ["host_id"]},
            "then": {"properties": {"status": {"const": "placeholder"}, "adapter_id": {"type": "null"}}}
          },
          {
            "if": {
              "properties": {
                "host_id": {"enum": ["claude", "hermes", "workbuddy"]},
                "asset_type": {"enum": ["mcp", "cli", "sdk"]}
              },
              "required": ["host_id", "asset_type"]
            },
            "then": {"properties": {"status": {"const": "not_connected"}, "adapter_id": {"type": "null"}}}
          },
          {
            "if": {
              "properties": {
                "host_id": {"enum": ["hermes", "workbuddy"]},
                "asset_type": {"const": "plugin"}
              },
              "required": ["host_id", "asset_type"]
            },
            "then": {"properties": {"status": {"const": "not_connected"}, "adapter_id": {"type": "null"}}}
          },
          {
            "if": {
              "properties": {
                "host_id": {"enum": ["codex", "claude", "hermes", "workbuddy"]},
                "asset_type": {"const": "skill"}
              },
              "required": ["host_id", "asset_type"]
            },
            "then": {"properties": {"adapter_id": {"const": "manifest_directory_v1"}, "status": {"enum": ["observed", "partial", "missing", "error"]}}}
          },
          {
            "if": {
              "properties": {
                "host_id": {"enum": ["codex", "claude"]},
                "asset_type": {"const": "plugin"}
              },
              "required": ["host_id", "asset_type"]
            },
            "then": {"properties": {"adapter_id": {"const": "manifest_directory_v1"}, "status": {"enum": ["observed", "partial", "missing", "error"]}}}
          },
          {
            "if": {"properties": {"host_id": {"const": "codex"}, "asset_type": {"const": "mcp"}}, "required": ["host_id", "asset_type"]},
            "then": {"properties": {
              "adapter_id": {"const": "codex_plugin_mcp_v1"},
              "configured_source_count": {"const": 1},
              "status": {"enum": ["observed", "partial", "missing", "error"]},
              "source_refs": {
                "contains": {"const": "~/.codex/plugins/cache"},
                "minContains": 1,
                "maxContains": 1,
                "items": {"oneOf": [
                  {"const": "~/.codex/plugins/cache"},
                  {"type": "string", "pattern": "^~/\\.codex/plugins/cache/(?!(?:\\.{1,2})/)[^/]+/(?!(?:\\.{1,2})/)[^/]+/(?!(?:\\.{1,2})/)[^/]+/\\.mcp\\.json$"}
                ]}
              }
            }}
          },
          {
            "if": {"properties": {"host_id": {"const": "codex"}, "asset_type": {"const": "cli"}}, "required": ["host_id", "asset_type"]},
            "then": {"properties": {
              "adapter_id": {"const": "codex_cli_metadata_v1"},
              "configured_source_count": {"const": 1},
              "observed_source_count": {"maximum": 1},
              "status": {"enum": ["observed", "partial", "missing", "error"]},
              "source_refs": {
                "minItems": 2,
                "maxItems": 2,
                "allOf": [
                  {"contains": {"const": "~/.local/bin/codex"}, "minContains": 1, "maxContains": 1},
                  {"contains": {"const": "~/.codex/plugins/.plugin-appserver/codex"}, "minContains": 1, "maxContains": 1}
                ]
              }
            }}
          },
          {
            "if": {"properties": {"host_id": {"const": "codex"}, "asset_type": {"const": "sdk"}}, "required": ["host_id", "asset_type"]},
            "then": {"properties": {
              "adapter_id": {"const": "codex_plugin_sdk_v1"},
              "configured_source_count": {"const": 1},
              "status": {"enum": ["observed", "partial", "missing", "error"]},
              "source_refs": {
                "contains": {"const": "~/.codex/plugins/cache"},
                "minContains": 1,
                "maxContains": 1,
                "items": {"oneOf": [
                  {"const": "~/.codex/plugins/cache"},
                  {"type": "string", "pattern": "^~/\\.codex/plugins/cache/(?!(?:\\.{1,2})/)[^/]+/(?!(?:\\.{1,2})/)[^/]+/(?!(?:\\.{1,2})/)[^/]+/package\\.json$"},
                  {"type": "string", "pattern": "^~/\\.codex/plugins/cache/(?!(?:\\.{1,2})/)[^/]+/(?!(?:\\.{1,2})/)[^/]+/(?!(?:\\.{1,2})/)[^/]+/node_modules/@modelcontextprotocol/sdk/package\\.json$"}
                ]}
              }
            }}
          }
        ]
      }
    },
    "scan_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "home", "roots", "coverage", "limits", "excluded", "safety"],
      "properties": {
        "mode": {"const": "read_only"},
        "home": {"const": "~/."},
        "roots": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "allOf": [
            {"contains": {"type": "object", "properties": {"host_id": {"const": "codex"}, "asset_type": {"const": "skill"}}, "required": ["host_id", "asset_type"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"host_id": {"const": "codex"}, "asset_type": {"const": "plugin"}}, "required": ["host_id", "asset_type"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"host_id": {"const": "claude"}, "asset_type": {"const": "skill"}}, "required": ["host_id", "asset_type"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"host_id": {"const": "claude"}, "asset_type": {"const": "plugin"}}, "required": ["host_id", "asset_type"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"host_id": {"const": "hermes"}, "asset_type": {"const": "skill"}}, "required": ["host_id", "asset_type"]}, "minContains": 1, "maxContains": 1},
            {"contains": {"type": "object", "properties": {"host_id": {"const": "workbuddy"}, "asset_type": {"const": "skill"}}, "required": ["host_id", "asset_type"]}, "minContains": 1, "maxContains": 1}
          ],
          "items": {"$ref": "#/$defs/root_scope"}
        },
        "coverage": {"$ref": "#/$defs/coverage"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_file_bytes", "max_overlay_bytes", "max_package_file_bytes", "max_package_bytes", "max_package_files", "max_depth", "max_entries_per_root", "scan_timeout_seconds", "max_text_length"],
          "properties": {
            "max_file_bytes": {"const": 262144},
            "max_overlay_bytes": {"const": 2097152},
            "max_package_file_bytes": {"const": 4194304},
            "max_package_bytes": {"const": 33554432},
            "max_package_files": {"const": 2000},
            "max_depth": {"const": 5},
            "max_entries_per_root": {"const": 5000},
            "scan_timeout_seconds": {"const": 8.0},
            "max_text_length": {"const": 4000}
          }
        },
        "excluded": {"const": ["/Applications", "browser_sessions", "credentials", "cookies", "ssh_aws", "other_projects", ".git", "unapproved_config_bodies", "codex_config_auth_and_global_state", "codex_logs_sessions_and_databases", "codex_dynamic_runtime_caches", "binaries", "path_wide_cli_discovery", "recursive_dependency_scans", "out_of_allowlist_symlinks", "ephemeral_system_managed_skills"]},
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["writes", "network", "process_execution", "follows_outside_symlinks", "reads_host_config_bodies"],
          "properties": {
            "writes": {"const": false},
            "network": {"const": false},
            "process_execution": {"const": false},
            "follows_outside_symlinks": {"const": false},
            "reads_host_config_bodies": {"const": false}
          }
        }
      }
    },
    "scan_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "host_id": {"type": "string"},
        "path": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
